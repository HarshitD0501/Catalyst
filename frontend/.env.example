# Google OAuth 2.0 Web Client ID (Required to render the Google Sign-In button)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Backend API Origin
# Leave blank for local development (Next.js automatically proxies /api to http://localhost:8000).
# When deployed to production, set this to your deployed backend URL (e.g., https://api.catalysthealth.app).
NEXT_PUBLIC_BACKEND_URL=

