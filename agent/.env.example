# --- Google Gemini (Voice Brain) ---
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- LiveKit Cloud (WebRTC Real-Time Audio Pipeline) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- STT & TTS Providers ---
# Deepgram Speech-to-Text (Hindi/Hinglish nova-3)
DEEPGRAM_API_KEY=your-deepgram-api-key
# Murf AI Text-to-Speech (Falcon hi-IN conversational voice)
MURF_API_KEY=your-murf-api-key

# --- Catalyst Backend Configuration ---
CATALYST_BACKEND_URL=http://localhost:8000
CATALYST_AGENT_NAME=catalyst-voice
DEFAULT_LANG=hi

